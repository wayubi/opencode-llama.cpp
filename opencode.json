{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "opencode-llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8089/v1",
        "toolParser": [
          { "type": "hermes" },
          { "type": "raw-function-call" },
          { "type": "json" }
        ]
      },
      "models": {
        "gemma4:26b": {
          "name": "Gemma 4 26B-A4B (Q4_K_M, MoE)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gemma4:e4b-q5": {
          "name": "Gemma 4 E4B (Q5_K_M, bartowski)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3coder:30b2": {
          "name": "Qwen3-Coder 30B-A3B (Q6, MoE)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 }
        },
        "qwen35:35b": {
          "name": "Qwen3.5 35B-A3B (Q4, MoE+SSM)",
          "tool_call": true,
          "limit": { "context": 262144, "output": 8192 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
