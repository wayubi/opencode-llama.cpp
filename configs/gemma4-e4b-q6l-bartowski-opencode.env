# Gemma 4 E4B IT Q6_K_L - bartowski imatrix - opencode optimized
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# Q6_K_L: critical layers (embeddings, LM head) at higher precision than Q6_K
# ~7.2GB model — may be tight at 128K, fall back to Q6_K if OOM

MODEL=bartowski/google_gemma-4-E4B-it-GGUF:Q6_K_L

PORT=8089
HOST=0.0.0.0

# 128K context - costs same VRAM as 32K (only 4 global-attn layers scale with context)
CTX=131072

# All 42 transformer layers on GPU
NGLAYERS=42

# Flash Attention required for large context and correct V cache sizing
FLASHATTN=on

# Large batch for fast prompt ingestion (important for long opencode sessions)
BATCH=2048
UBATCH=512

# CPU threads for the Xeon
THREADS=20
THREADS_BATCH=20

# Single user = 1 slot, full 128K dedicated to one session
PARALLEL=1

# Q4 KV cache - same VRAM as f16 at 32K due to Gemma 4's SWA architecture
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
