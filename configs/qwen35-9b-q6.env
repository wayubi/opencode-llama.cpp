# GLM-4.7-Flash (30B-A3B MoE) - unsloth UD-Q4_K_XL
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# MoE: backbone on GPU (~3-4GB), experts on CPU (~18GB RAM)
# --jinja is hardcoded in docker-compose.yml (required for GLM chat template)
# Note: llama.cpp default min-p=0.05; upstream recommends min-p=0.01 for this model

MODEL=unsloth/Qwen3.5-9B-GGUF:UD-Q6_K_XL

PORT=8089
HOST=0.0.0.0

# Native ctx = 202752
CTX=131072

# All non-expert layers on GPU; experts on CPU
NGLAYERS=999

# MoE experts on CPU
CPUMOE=exps=CPU

FLASHATTN=on

BATCH=4096
UBATCH=1024

THREADS=24
THREADS_BATCH=24

PARALLEL=1

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
