# Qwen3.6-35B-A3B (MoE hybrid: attention + SSM) - unsloth UD-Q4_K_XL
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# GPU: ~2GB backbone (40 layers), RAM: ~19GB experts; vision encoder included
# SSM layers have no KV cache growth — 262K context costs ~720MB KV (10 attn layers only)

MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_XL

PORT=8089
HOST=0.0.0.0

# Native ctx = 262144; cheap due to hybrid SSM (only 10 attn layers have KV)
CTX=262144

# All layers on GPU (experts stay on CPU via CPUMOE)
NGLAYERS=999

# MoE experts on CPU
CPUMOE=exps=CPU

FLASHATTN=on

BATCH=4096
UBATCH=1024

THREADS=24
THREADS_BATCH=24

PARALLEL=1

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0

# MTP
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=4

# Unsloth coding preset
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.00
PRESENCE_PENALTY=0.0
