# Phi-4 14B - bartowski Q4_K_M
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# Dense model — all layers on GPU, ~8.5GB model + ~1GB KV = ~9.5GB total
# NOTE: tool call compatibility unconfirmed — test before relying on for opencode

MODEL=bartowski/microsoft_Phi-4-GGUF:Q4_K_M

PORT=8089
HOST=0.0.0.0

# Native context is 16K — can extend with RoPE scaling but quality may degrade
CTX=16384

# All layers on GPU (dense model, no expert offloading)
NGLAYERS=999

FLASHATTN=on

BATCH=1024
UBATCH=512

THREADS=20
THREADS_BATCH=20

PARALLEL=1

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
