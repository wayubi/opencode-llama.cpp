# Qwen3.5-9B-Coder-MTP Q6_K
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# Hybrid-attention 9B coder model with MTP speculative decoding
# Full GPU offload with long-context SSM memory efficiency

MODEL=Jackrong/Qwopus3.5-9B-Coder-MTP-GGUF:Q6_K

PORT=8089
HOST=0.0.0.0

# Native ctx = 262144; cheap due to hybrid SSM (only 10 attn layers have KV)
CTX=262144

# All layers on GPU (experts stay on CPU via CPUMOE)
NGLAYERS=999

FLASHATTN=on

BATCH=1024
UBATCH=512

THREADS=24
THREADS_BATCH=24

PARALLEL=1

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0

# MTP
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=4

# Unsloth coding preset
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.00
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0
