# Qwen3.5-35B-A3B (MoE hybrid: attention + SSM) - unsloth UD-Q4_K_XL
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# GPU: ~2GB backbone (40 layers), RAM: ~19GB experts; vision encoder included
# SSM layers have no KV cache growth — 131K context costs ~720MB KV (10 attn layers only)

MODEL=unsloth/Qwen3.5-35B-A3B-GGUF:UD-Q4_K_XL

PORT=8089
HOST=0.0.0.0

# Native ctx = 262144; 131K cheap due to hybrid SSM (only 10 attn layers have KV)
CTX=262144

# All layers on GPU (experts stay on CPU via CPUMOE)
NGLAYERS=999

# MoE experts on CPU
CPUMOE=exps=CPU

FLASHATTN=on

BATCH=1024
UBATCH=512

THREADS=20
THREADS_BATCH=20

PARALLEL=1

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
