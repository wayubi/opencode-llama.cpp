# Qwen3-Coder-30B-A3B-Instruct (MoE) - unsloth Q6_K
# RTX 3060 12GB / Xeon E5-2697 v3 (14c/28t) / 128GB RAM
# MoE: backbone on GPU (~3-4GB), experts on CPU (~25GB RAM)
# Dedicated coding model — Hermes tool call format, compatible with opencode

MODEL=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q6_K

PORT=8089
HOST=0.0.0.0

# Native ctx = 262144
CTX=262144

# All layers on GPU (experts stay on CPU via CPUMOE)
NGLAYERS=999

# MoE experts on CPU
CPUMOE=exps=CPU

FLASHATTN=on

BATCH=1024
UBATCH=512

THREADS=20
THREADS_BATCH=20

PARALLEL=1

CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
